# Example environment for a public deployment. Copy, set, do not commit.
# Every value here is a decision. None of them has been made.

# Bind on every interface only because a container's port mapping needs it.
COAL_LSL_HOST=0.0.0.0
COAL_LSL_PORT=8080

# Declared in discovery and enforced before the body is parsed.
COAL_LSL_MAX_BODY_BYTES=16384
COAL_LSL_RATE_LIMIT_PER_MINUTE=60

# Set only if a browser page on these exact origins must call the service.
# Empty means no browser may read a response, which is the safer default.
COAL_LSL_ALLOWED_ORIGINS=

# 1 only when a proxy you control sets X-Forwarded-For. With 0, throttling
# keys on the socket address, which behind a proxy is the proxy itself.
COAL_LSL_TRUST_PROXY=0

# The URL the OpenAPI document advertises. Must be the stable public one.
COAL_LSL_PUBLIC_BASE_URL=https://example.invalid

# The git revision built into the image, for the response manifest.
COAL_LSL_CODE_REVISION=

# Change only if the registry agrees another spelling.
# COAL_LSL_CALCULATOR_URN=urn:sbrm:calc:coal-lsl-levy
