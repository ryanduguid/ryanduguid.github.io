# Example Knative service definition. Not applied. Every PLACEHOLDER must be
# replaced by a real deployment, and the instance cap must be set before an
# unauthenticated endpoint is exposed.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: coal-lsl-levy
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        # The cost bound. The publishing standard asks publishers to cap their
        # own spend; this is that cap.
        autoscaling.knative.dev/maxScale: "3"
        autoscaling.knative.dev/minScale: "0"
    spec:
      containerConcurrency: 40
      timeoutSeconds: 30
      serviceAccountName: PLACEHOLDER-no-permissions@PLACEHOLDER.iam.gserviceaccount.com
      containers:
        - image: PLACEHOLDER-region-docker.pkg.dev/PLACEHOLDER/coal-lsl-levy@sha256:PLACEHOLDER
          ports:
            - containerPort: 8080
          env:
            - name: COAL_LSL_HOST
              value: "0.0.0.0"
            - name: COAL_LSL_PORT
              value: "8080"
            - name: COAL_LSL_PUBLIC_BASE_URL
              value: "https://PLACEHOLDER"
            - name: COAL_LSL_TRUST_PROXY
              value: "1"
            # How many proxies you control sit in front. Cloud Run's front end
            # appends one entry, and a caller may have written its own to the
            # left of it, so the caller is the LAST entry: depth 0. Raise this
            # only if you add a proxy of your own in front of Cloud Run, and
            # never guess: the wrong depth keys the throttle on a value the
            # caller controls.
            - name: COAL_LSL_TRUSTED_PROXY_DEPTH
              value: "0"
            - name: COAL_LSL_CODE_REVISION
              value: "PLACEHOLDER"
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          securityContext:
            runAsNonRoot: true
          startupProbe:
            httpGet:
              path: /healthz
            failureThreshold: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /livez
            periodSeconds: 30
