* text=auto eol=lf

# Written by the build scripts, so GitHub folds them in pull request diffs.
# Keep committing them. sitemap.xml is edited by hand, and the agent-skills
# index stays unfolded because its install commands need review.
llms-full.txt linguist-generated
index.txt linguist-generated
.well-known/llms.txt linguist-generated
feed.xml linguist-generated
_includes/ozzit-reference.html linguist-generated
scripts/design_baseline.json linguist-generated
tests/browser/*-snapshots/** linguist-generated
# site-tools build_effective_life_pages writes the effective life pages. Marking
# them generated also keeps their HTML out of the repository's language counts,
# where it outweighed the Rust that OpenSSF Scorecard reads for fuzz targets.
tools/depreciation-rates/industry/** linguist-generated
tools/depreciation-rates/asset/** linguist-generated

# Every pull request that adds or edits a page rewrites the files the builders
# write from the pages, so two of them always conflicted there. With the
# generated merge driver configured (CONTRIBUTING.md), a merge keeps the current
# side of each, merges the hand-kept part of llms.txt and the design baseline's
# keys, and leaves the builders to write them again; unconfigured, Git merges as usual.
llms.txt merge=generated
.well-known/llms.txt merge=generated
llms-full.txt merge=generated
llms-full-*.txt merge=generated
index.txt merge=generated
scripts/design_baseline.json merge=generated

# Concurrent pull requests each add a dated row at the top of a changelog table.
# With the changelog-rows driver configured (CONTRIBUTING.md), a merge or rebase
# keeps both sides' new rows in date order; unconfigured, Git merges as usual.
changelog/index.html merge=changelog-rows
changelog/index.txt merge=changelog-rows
feed.xml merge=changelog-rows
